{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>gitify-app/.github"],
  "forkProcessing": "enabled",
  "packageRules": [
    {
      "description": "Keep peer dependency ranges wide rather than pinning them to one version.",
      "matchDepTypes": ["peerDependencies"],
      "rangeStrategy": "widen"
    },
    {
      "matchDepTypes": ["engines"],
      "rangeStrategy": "auto"
    },
    {
      "description": "Give Electron updates a distinct scope so release-please can include them in the changelog.",
      "matchPackageNames": ["electron"],
      "semanticCommitScope": "deps-core"
    }
  ]
}
